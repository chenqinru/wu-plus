#!/usr/bin/env bash

set -euo pipefail
source script/lib/blob-store.sh

build_flag="--release"
zed_features="--features gpui_platform/runtime_shaders"
remote_server_features=""
target_dir="release"
app_only=false
skip_remote_server=false
remote_server_only=false
open_result=false
local_install=false
can_code_sign=false
self_signed=false

# Common name of the signing certificate in MACOS_CERTIFICATE.
IDENTITY="${MACOS_SIGNING_IDENTITY:-Farshed}"
APPLE_NOTARIZATION_TEAM="${APPLE_NOTARIZATION_TEAM:-}"
# Optional path to a provisioning profile to embed in the app bundle.
MACOS_PROVISIONING_PROFILE="${MACOS_PROVISIONING_PROFILE:-}"

# Function for displaying help info
help_info() {
  echo "
Usage: ${0##*/} [options] [architecture=host]
Build the application bundle for macOS.

Options:
  -a    Build the application bundle only, without the DMG, dSYM, or remote server.
  -s    Build the application and its release artifacts without the remote server.
  -r    Build and package only the remote server.
  -d    Compile in debug mode
  -o    Open dir with the resulting DMG or launch the app itself in local mode.
  -i    Install the resulting DMG into /Applications.
  -h    Display this help and exit.
  "
}

while getopts 'arsdloih' flag
do
    case "${flag}" in
        a) app_only=true; skip_remote_server=true;;
        s) skip_remote_server=true;;
        r) remote_server_only=true;;
        o) open_result=true;;
        d)
            export CARGO_INCREMENTAL=true
            build_flag="";
            zed_features="--features gpui_platform/runtime_shaders,util/debug-embed"
            remote_server_features="--features debug-embed"
            target_dir="debug"
            ;;
        i) local_install=true;;
        h)
           help_info
           exit 0
           ;;
    esac
done

shift $((OPTIND-1))

if [[ "$remote_server_only" == true && ( "$skip_remote_server" == true || "$local_install" == true || "$open_result" == true ) ]]; then
    echo 'The -r option cannot be used with -a, -s, -i, or -o.' >&2
    exit 1
fi

# Get release channel
pushd crates/wu
channel=${ZED_RELEASE_CHANNEL:-$(<RELEASE_CHANNEL)}
export ZED_RELEASE_CHANNEL="${channel}"
popd

export ZED_BUNDLE=true
export CARGO_BUNDLE_SKIP_BUILD=true

if [[ "$remote_server_only" == false ]]; then
    cargo_bundle_version=$(cargo -q bundle --help 2>&1 | head -n 1 || echo "")
    if [ "$cargo_bundle_version" != "cargo-bundle v0.6.1-zed" ]; then
        cargo install cargo-bundle --git https://github.com/zed-industries/cargo-bundle.git --branch zed-deploy
    fi
fi

# Deal with versions of macOS that don't include libstdc++ headers
export CXXFLAGS="-stdlib=libc++"

version_info=$(rustc --version --verbose)
host_line=$(echo "$version_info" | grep host)
target_triple=${host_line#*: }
if [[ $# -gt 0 && -n "$1" ]]; then
    target_triple="$1"
fi
arch_suffix=""

if [[ "$target_triple" = "x86_64-apple-darwin" ]]; then
    arch_suffix="x86_64"
elif [[ "$target_triple" = "aarch64-apple-darwin" ]]; then
    arch_suffix="aarch64"
else
    echo "Unsupported architecture $target_triple"
    exit 1
fi

rustup target add $target_triple

if [[ "$remote_server_only" == false ]]; then
    # The application embeds the generated license notices.
    script/generate-licenses
    echo "Compiling wu binaries"
    if [[ "$target_dir" = "release" ]]; then
        cargo --config .cargo/bundle-config.toml rustc ${build_flag} ${zed_features} --package wu --bin wu --target $target_triple -- -C 'link-arg=-Wl,-unexported_symbol,__R*'
        cargo --config .cargo/bundle-config.toml build ${build_flag} --package cli --target $target_triple
    else
        cargo --config .cargo/bundle-config.toml build ${build_flag} ${zed_features} --package wu --package cli --target $target_triple
    fi
fi
if [[ "$skip_remote_server" == false ]]; then
    # Build remote_server in separate invocation to prevent feature unification from other crates
    # from influencing dynamic libraries required by it.
    cargo --config .cargo/bundle-config.toml build ${build_flag} ${remote_server_features} --package remote_server --target $target_triple
fi

if [[ "$remote_server_only" == false ]]; then
    echo "Creating application bundle"
    app_path=$(
        set -e
        cd crates/wu
        cp Cargo.toml Cargo.toml.backup
        trap 'mv Cargo.toml.backup Cargo.toml' EXIT
        sed -i '' "s/package.metadata.bundle-${channel}/package.metadata.bundle/" Cargo.toml
        cargo bundle ${build_flag} --target $target_triple --select-workspace-root | xargs
    )
    echo "Bundled ${app_path}"

    plist="$app_path/Contents/Info.plist"
    upstream_version=$(plutil -extract CFBundleShortVersionString raw "$plist")
    plus_revision=$(<crates/release_channel/WU_PLUS_REVISION)
    plutil -replace WuPlusVersion -string "$upstream_version.$plus_revision" "$plist"

    # DocumentTypes.plist references CFBundleTypeIconFile "Document", so the bundle must contain Document.icns.
    document_icon_source="crates/wu/resources/Document.icns"
    document_icon_target="${app_path}/Contents/Resources/Document.icns"
    if [[ -f "${document_icon_source}" ]]; then
        mkdir -p "$(dirname "${document_icon_target}")"
        cp "${document_icon_source}" "${document_icon_target}"
    else
        echo "cargo::warning=Missing ${document_icon_source}; macOS document icons may not appear in Finder."
    fi
fi

if [[ -n "${MACOS_CERTIFICATE:-}" && -n "${MACOS_CERTIFICATE_PASSWORD:-}" ]]; then
    if [[ -n "${APPLE_NOTARIZATION_KEY:-}" && -n "${APPLE_NOTARIZATION_KEY_ID:-}" && -n "${APPLE_NOTARIZATION_ISSUER_ID:-}" ]]; then
        can_code_sign=true

        if [[ -z "$APPLE_NOTARIZATION_TEAM" ]]; then
            echo "APPLE_NOTARIZATION_TEAM must be set when code signing is enabled"
            exit 1
        fi
    else
        self_signed=true
        echo "No notarization credentials, so the bundle is signed with \"${IDENTITY}\" and not notarized"
    fi

    echo "Setting up keychain for code signing..."
    security create-keychain -p "$MACOS_CERTIFICATE_PASSWORD" zed.keychain || echo ""
    security default-keychain -s zed.keychain
    security unlock-keychain -p "$MACOS_CERTIFICATE_PASSWORD" zed.keychain
    # Calling set-keychain-settings without `-t` disables the auto-lock timeout
    security set-keychain-settings zed.keychain
    echo "$MACOS_CERTIFICATE" | base64 --decode > /tmp/zed-certificate.p12
    security import /tmp/zed-certificate.p12 -k zed.keychain -P "$MACOS_CERTIFICATE_PASSWORD" -T /usr/bin/codesign
    rm /tmp/zed-certificate.p12
    security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "$MACOS_CERTIFICATE_PASSWORD" zed.keychain

    function cleanup() {
        echo "Cleaning up keychain"
        security default-keychain -s login.keychain
        security delete-keychain zed.keychain
    }

    trap cleanup EXIT
fi

GIT_VERSION="v2.43.3"
GIT_VERSION_SHA="fa29823"

function download_and_unpack() {
    local url=$1
    local path_to_unpack=$2
    local target_path=$3

    temp_dir=$(mktemp -d)

    if ! command -v curl &> /dev/null; then
        echo "curl is not installed. Please install curl to continue."
        exit 1
    fi

    curl --silent --fail --location "$url" | tar -xvz -C "$temp_dir" -f - $path_to_unpack

    mv "$temp_dir/$path_to_unpack" "$target_path"

    rm -rf "$temp_dir"
}

function download_git() {
    local architecture=$1
    local target_binary=$2

    tmp_dir=$(mktemp -d)
    pushd "$tmp_dir"

    case "$architecture" in
        aarch64-apple-darwin)
            download_and_unpack "https://github.com/desktop/dugite-native/releases/download/${GIT_VERSION}/dugite-native-${GIT_VERSION}-${GIT_VERSION_SHA}-macOS-arm64.tar.gz" bin/git ./git
            ;;
        x86_64-apple-darwin)
            download_and_unpack "https://github.com/desktop/dugite-native/releases/download/${GIT_VERSION}/dugite-native-${GIT_VERSION}-${GIT_VERSION_SHA}-macOS-x64.tar.gz" bin/git ./git
            ;;
        *)
            echo "Unsupported architecture: $architecture"
            exit 1
            ;;
    esac

    popd

    mv "${tmp_dir}/git" "${target_binary}"
    rm -rf "$tmp_dir"
}

function sign_app_binaries() {
    rm -rf "${app_path}/Contents/Frameworks"
    mkdir -p "${app_path}/Contents/Frameworks"

    echo "Downloading git binary"
    download_git "${target_triple}" "${app_path}/Contents/MacOS/git"

    if [[ -n "$MACOS_PROVISIONING_PROFILE" ]]; then
        echo "Embedding provisioning profile from ${MACOS_PROVISIONING_PROFILE}"
        cp "$MACOS_PROVISIONING_PROFILE" "${app_path}/Contents/embedded.provisionprofile"
    fi

    if [[ $can_code_sign = true ]]; then
        echo "Code signing binaries"
        # sequence of codesign commands modeled after this example: https://developer.apple.com/forums/thread/701514
        /usr/bin/codesign --deep --force --timestamp --options runtime --sign "$IDENTITY" "${app_path}/Contents/MacOS/cli" -v
        /usr/bin/codesign --deep --force --timestamp --options runtime --sign "$IDENTITY" "${app_path}/Contents/MacOS/git" -v
        /usr/bin/codesign --force --timestamp --options runtime --sign "$IDENTITY" "${app_path}/Contents/MacOS/wu-plus-subversion-provider" -v
        /usr/bin/codesign --deep --force --timestamp --options runtime --entitlements crates/wu/resources/zed.entitlements --sign "$IDENTITY" "${app_path}/Contents/MacOS/wu" -v
        /usr/bin/codesign --force --timestamp --options runtime --entitlements crates/wu/resources/zed.entitlements --sign "$IDENTITY" "${app_path}" -v
    elif [[ $self_signed = true ]]; then
        echo "Code signing binaries with a self-signed certificate"
        # Apple's timestamp server and notarization only accept Apple-issued certificates.
        /usr/bin/codesign --force --timestamp=none --sign "$IDENTITY" "${app_path}/Contents/MacOS/cli" -v
        /usr/bin/codesign --force --timestamp=none --sign "$IDENTITY" "${app_path}/Contents/MacOS/git" -v
        /usr/bin/codesign --force --timestamp=none --sign "$IDENTITY" "${app_path}/Contents/MacOS/wu-plus-subversion-provider" -v
        /usr/bin/codesign --force --timestamp=none --entitlements crates/wu/resources/zed.entitlements --sign "$IDENTITY" "${app_path}/Contents/MacOS/wu" -v
        /usr/bin/codesign --force --timestamp=none --entitlements crates/wu/resources/zed.entitlements --sign "$IDENTITY" "${app_path}" -v
        /usr/bin/codesign --verify --deep --strict --verbose=2 "${app_path}"
        echo "Designated requirement:"
        /usr/bin/codesign --display --requirements - "${app_path}"
    else
        echo "One or more of the following variables are missing: MACOS_CERTIFICATE, MACOS_CERTIFICATE_PASSWORD, APPLE_NOTARIZATION_KEY, APPLE_NOTARIZATION_KEY_ID, APPLE_NOTARIZATION_ISSUER_ID"

        echo "====== WARNING ======"
        echo "This bundle is being signed without all entitlements, some features (e.g. universal links) will not work"
        echo "====== WARNING ======"

        # NOTE: if you need to test universal links you have a few paths forward:
        # - create a PR and tag it with the `run-bundling` label, and download the .dmg file from there.
        # - create your own signing key and set APPLE_NOTARIZATION_TEAM to your own team ID
        # then comment out this line.
        cat crates/wu/resources/zed.entitlements | sed '/com.apple.developer.associated-domains/,+1d' > "${app_path}/Contents/Resources/zed.entitlements"

        codesign --force --deep --entitlements "${app_path}/Contents/Resources/zed.entitlements" --sign ${MACOS_SIGNING_KEY:- -} "${app_path}" -v
    fi

    codesign --verify --deep --strict "$app_path"

    bundle_name=$(basename "$app_path")

    if [ "$local_install" = true ]; then
        rm -rf "/Applications/$bundle_name"
        mv "$app_path" "/Applications/$bundle_name"
        echo "Installed application bundle: /Applications/$bundle_name"
        if [ "$open_result" = true ]; then
            echo "Opening /Applications/$bundle_name"
            open "/Applications/$bundle_name"
        fi
    elif [ "$open_result" = true ]; then
        open "$app_path"
    fi

    if [[ "$app_only" == true || "$target_dir" == "debug" ]]; then
        if [ "$local_install" = false ]; then
            echo "Created application bundle:"
            echo "$app_path"
        fi
    else
        dmg_target_directory="target/${target_triple}/${target_dir}"
        dmg_source_directory="${dmg_target_directory}/dmg"
        dmg_file_path="${dmg_target_directory}/Wu-Plus-${arch_suffix}.dmg"
        xcode_bin_dir_path="$(xcode-select -p)/usr/bin"

        rm -rf ${dmg_source_directory}
        mkdir -p ${dmg_source_directory}
        mv "${app_path}" "${dmg_source_directory}"
        notarization_key_file=$(mktemp)

        echo "Adding symlink to /Applications to ${dmg_source_directory}"
        ln -s /Applications ${dmg_source_directory}

        echo "Creating final DMG at ${dmg_file_path} using ${dmg_source_directory}"
        hdiutil create -volname 'Wu Plus' -srcfolder "${dmg_source_directory}" -ov -format UDZO "${dmg_file_path}"

        # If someone runs this bundle script locally, a symlink will be placed in `dmg_source_directory`.
        # This symlink causes CPU issues with Zed if the Zed codebase is the project being worked on, so we simply remove it for now.
        echo "Removing symlink to /Applications from ${dmg_source_directory}"
        rm ${dmg_source_directory}/Applications

        if [[ $can_code_sign = true ]]; then
            echo "Notarizing DMG with Apple"
            /usr/bin/codesign --deep --force --timestamp --options runtime --sign "$IDENTITY" "$(pwd)/${dmg_file_path}" -v
            echo "$APPLE_NOTARIZATION_KEY" > "$notarization_key_file"
            "${xcode_bin_dir_path}/notarytool" submit --wait --key "$notarization_key_file" --key-id "$APPLE_NOTARIZATION_KEY_ID" --issuer "$APPLE_NOTARIZATION_ISSUER_ID" --team-id "$APPLE_NOTARIZATION_TEAM" "${dmg_file_path}"
            rm "$notarization_key_file"
            "${xcode_bin_dir_path}/stapler" staple "${dmg_file_path}"
        fi

        if [ "$open_result" = true ]; then
            open $dmg_target_directory
        fi
    fi
}

function sign_binary() {
    local binary_path=$1

    if [[ $can_code_sign = true ]]; then
        echo "Code signing executable $binary_path"
        /usr/bin/codesign --deep --force --timestamp --options runtime --entitlements crates/wu/resources/zed.entitlements --sign "$IDENTITY" "${binary_path}" -v
    elif [[ $self_signed = true ]]; then
        echo "Code signing executable $binary_path with a self-signed certificate"
        /usr/bin/codesign --force --timestamp=none --sign "$IDENTITY" "${binary_path}" -v
    fi
}

function bundle_remote_server() {
    local server_binary="target/$target_triple/$target_dir/remote_server"
    lipo "$server_binary" -verify_arch "${arch_suffix/aarch64/arm64}"
    if [[ "$target_dir" == "release" && "$local_install" != true ]]; then
        strip -x "$server_binary"
    fi
    sign_binary "$server_binary"
    gzip -f --stdout --best "$server_binary" > "target/wu-remote-server-macos-$arch_suffix.gz"
}

if [[ "$remote_server_only" == true ]]; then
    bundle_remote_server
    exit 0
fi

cp target/${target_triple}/${target_dir}/wu "${app_path}/Contents/MacOS/wu"
cp target/${target_triple}/${target_dir}/cli "${app_path}/Contents/MacOS/cli"
(
    unset MACOS_CERTIFICATE MACOS_CERTIFICATE_PASSWORD APPLE_NOTARIZATION_KEY \
        APPLE_NOTARIZATION_KEY_ID APPLE_NOTARIZATION_ISSUER_ID
    CARGO_BUILD_TARGET="$target_triple" scripts/package-plugin.sh --bundle "$app_path"
)
lipo "${app_path}/Contents/MacOS/wu-plus-subversion-provider" -verify_arch "${arch_suffix/aarch64/arm64}"

if [[ "$app_only" == false && "$target_dir" = "release" && -n "${CI:-}${BUNDLE_DSYM:-}" ]]; then
    dsym_path="target/${target_triple}/${target_dir}/Wu.dSYM"
    rm -rf "$dsym_path" "${dsym_path}.zip"
    # Use rustc's dSYM when split-debuginfo produced one, otherwise build it.
    if [[ -d "target/${target_triple}/${target_dir}/wu.dSYM" ]]; then
        cp -R "target/${target_triple}/${target_dir}/wu.dSYM" "$dsym_path"
    else
        dsymutil "target/${target_triple}/${target_dir}/wu" -o "$dsym_path"
    fi
    ditto -c -k --keepParent "$dsym_path" "${dsym_path}.zip"
    echo "Created debug symbols at ${dsym_path}.zip"
fi

if [[ "$target_dir" = "release" && "$local_install" != true ]]; then
    strip -x "${app_path}/Contents/MacOS/wu" "${app_path}/Contents/MacOS/cli"
fi

sign_app_binaries

if [[ "$skip_remote_server" == false ]]; then
    bundle_remote_server
fi
