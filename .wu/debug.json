[
  {
    "label": "调试 Wu Plus（Apple Silicon / SVN）",
    "adapter": "CodeLLDB",
    "adapter_binary": ".build/codelldb/extension/adapter/codelldb",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/.build/dev-bin/wu",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": ["--user-data-dir", "$ZED_WORKTREE_ROOT/.build/dev-profile"],
    "sourceLanguages": ["rust"],
    "build": {
      "label": "构建 Wu Plus 和 SVN 后台",
      "command": "./scripts/wu.sh",
      "args": ["prepare-debug"],
      "cwd": "$ZED_WORKTREE_ROOT"
    }
  },
  {
    "label": "Debug Wu Plus (CodeLLDB)",
    "adapter": "CodeLLDB",
    "build": {
      "label": "Build Wu Plus",
      "command": "cargo",
      "args": ["build", "-p", "wu", "--bin", "wu"]
    }
  }
]
